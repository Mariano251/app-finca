generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Estructura de la finca
// ---------------------------------------------------------------------------

model Finca {
  id              Int      @id @default(autoincrement())
  nombre          String
  ubicacion       String?
  superficieTotal Float?
  /// Coordenadas para el widget de clima (pronóstico automático vía Open-Meteo). Nulas hasta que
  /// el usuario las configura (a mano o con "Usar mi ubicación actual" desde el celular).
  latitud         Float?
  longitud        Float?
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sectores         Sector[]
  croquis          Croquis[]
  costosIndirectos CostoIndirecto[]
  insumos          Insumo[]
}

model Sector {
  id          Int      @id @default(autoincrement())
  fincaId     Int
  finca       Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cuadros Cuadro[]

  @@index([fincaId])
}

enum SistemaRiego {
  GOTEO
  ASPERSION
  GRAVEDAD
  PIVOTE
  MICROASPERSION
  SECANO
  OTRO
}

model Cuadro {
  id                   Int           @id @default(autoincrement())
  sectorId             Int
  sector               Sector        @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  nombre               String
  superficie           Float?
  ubicacion            String?
  tipoSuelo            String?
  caracteristicasSuelo String?
  sistemaRiego         SistemaRiego?
  notas                String?
  activo               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  campanas         Campana[]
  croquisPoligonos CroquisPoligono[]

  @@index([sectorId])
}

// ---------------------------------------------------------------------------
// Catalogos de cultivo
// ---------------------------------------------------------------------------

model Cultivo {
  id               Int      @id @default(autoincrement())
  nombre           String   @unique
  nombreCientifico String?
  notas            String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variedades Variedad[]
  campanas   Campana[]

  principiosActivos    PrincipioActivo[]
  productosComerciales ProductoComercial[]
}

model Variedad {
  id        Int      @id @default(autoincrement())
  cultivoId Int
  cultivo   Cultivo  @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  nombre    String
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campanas Campana[]

  @@index([cultivoId])
}

// ---------------------------------------------------------------------------
// Campana: entidad central de la que cuelga todo el historial
// ---------------------------------------------------------------------------

enum EstadoCampana {
  PLANIFICADA
  ACTIVA
  COSECHADA
  FINALIZADA
  CANCELADA
}

model Campana {
  id                   Int           @id @default(autoincrement())
  cuadroId             Int
  cuadro               Cuadro        @relation(fields: [cuadroId], references: [id], onDelete: Cascade)
  cultivoId            Int
  cultivo              Cultivo       @relation(fields: [cultivoId], references: [id])
  variedadId           Int?
  variedad             Variedad?     @relation(fields: [variedadId], references: [id])
  nombre               String
  fechaPlantacion      DateTime?
  fechaCosechaEstimada DateTime?
  fechaCosechaReal     DateTime?
  estado               EstadoCampana @default(PLANIFICADA)
  superficieImplantada Float?
  notas                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  laboresCulturales         LaborCultural[]
  aplicaciones              AplicacionFitosanitaria[]
  fertilizaciones           Fertilizacion[]
  riegos                    Riego[]
  fenologias                Fenologia[]
  eventosClimaticos         EventoClimatico[]
  malezas                   Maleza[]
  enfermedades              Enfermedad[]
  plagas                    Plaga[]
  comentarios               Comentario[]
  cosechas                  Cosecha[]
  costos                    Costo[]
  ventas                    Venta[]
  presupuestos              Presupuesto[]
  costosIndirectosAsignados CostoIndirectoAsignacion[]

  @@index([cuadroId])
  @@index([cultivoId])
}

// ---------------------------------------------------------------------------
// Sub-registros de campana
// ---------------------------------------------------------------------------

enum EstadoTarea {
  PLANIFICADA
  REALIZADA
}

enum TipoLabor {
  PREPARACION_SUELO
  PLANTACION
  FERTILIZACION
  RIEGO
  PODA
  DESMALEZADO
  APLICACION
  COSECHA
  OTRO
}

model LaborCultural {
  id                Int         @id @default(autoincrement())
  campanaId         Int
  campana           Campana     @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  tipo              TipoLabor
  fecha             DateTime
  descripcion       String?
  responsable       String?
  estado            EstadoTarea @default(REALIZADA)
  insumoId          Int?
  insumo            Insumo?     @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  cantidadUtilizada Float?
  notas             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([campanaId])
  @@index([insumoId])
}

enum TipoFitosanitario {
  FUNGICIDA
  INSECTICIDA
  HERBICIDA
  ACARICIDA
  NEMATICIDA
  BACTERICIDA
  OTRO
}

enum BaseDosis {
  HECTAREA
  CALDO
}

model AplicacionFitosanitaria {
  id                     Int                @id @default(autoincrement())
  campanaId              Int
  campana                Campana            @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha                  DateTime
  productoComercial      String
  principioActivo        String?
  tipo                   TipoFitosanitario
  dosis                  Float?
  unidadDosis            String?
  baseDosis              BaseDosis?
  volumenCaldo           Float?
  superficieTratada      Float?
  problemaObjetivo       String?
  estadoCultivo          String?
  responsable            String?
  estado                 EstadoTarea        @default(REALIZADA)
  insumoId               Int?
  insumo                 Insumo?            @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  cantidadUtilizada      Float?
  observaciones          String?
  // Link opcional al producto elegido desde la Biblioteca de Productos y Principios Activos:
  // cuando está seteado, productoComercial/principioActivo (texto libre arriba) se autocompletaron
  // desde ahí y este id habilita el historial/alerta de rotación de grupos de acción por lote.
  productoComercialLibId Int?
  productoComercialLib   ProductoComercial? @relation(fields: [productoComercialLibId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([campanaId])
  @@index([insumoId])
  @@index([productoComercialLibId])
}

model Fertilizacion {
  id                Int      @id @default(autoincrement())
  campanaId         Int
  campana           Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha             DateTime
  producto          String
  dosis             Float?
  unidadDosis       String?
  nUnidades         Float?
  pUnidades         Float?
  kUnidades         Float?
  otrosNutrientes   String?
  formaAplicacion   String?
  responsable       String?
  insumoId          Int?
  insumo            Insumo?  @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  cantidadUtilizada Float?
  observaciones     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([campanaId])
  @@index([insumoId])
}

model Riego {
  id              Int      @id @default(autoincrement())
  campanaId       Int
  campana         Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha           DateTime
  duracionHoras   Float?
  volumenEstimado Float?
  observaciones   String?
  responsable     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campanaId])
}

model Fenologia {
  id               Int      @id @default(autoincrement())
  campanaId        Int
  campana          Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha            DateTime
  estadoFenologico String
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([campanaId])
}

enum TipoEventoClimatico {
  HELADA
  GRANIZO
  VIENTO
  ALTA_TEMPERATURA
  LLUVIA
  SEQUIA
  OTRO
}

enum NivelSeveridad {
  LEVE
  MODERADA
  SEVERA
}

model EventoClimatico {
  id          Int                 @id @default(autoincrement())
  campanaId   Int
  campana     Campana             @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha       DateTime
  tipo        TipoEventoClimatico
  severidad   NivelSeveridad?
  descripcion String?
  notas       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([campanaId])
}

enum NivelInfestacion {
  BAJO
  MEDIO
  ALTO
}

model Maleza {
  id                   Int               @id @default(autoincrement())
  campanaId            Int
  campana              Campana           @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha                DateTime
  especie              String
  nivelInfestacion     NivelInfestacion?
  ubicacion            String?
  tratamientoRealizado String?
  responsable          String?
  notas                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Ubicacion opcional del circulo en el croquis de la finca: mismo esquema que Enfermedad.
  croquisId   Int?
  croquis     Croquis? @relation(fields: [croquisId], references: [id], onDelete: SetNull)
  croquisX    Float?
  croquisY    Float?
  radioMetros Float?

  @@index([campanaId])
  @@index([especie])
  @@index([croquisId])
}

model Enfermedad {
  id                   Int               @id @default(autoincrement())
  campanaId            Int
  campana              Campana           @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha                DateTime
  nombre               String
  nivelIncidencia      NivelInfestacion?
  sectorAfectado       String?
  diagnostico          String?
  tratamientoRealizado String?
  responsable          String?
  notas                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Ubicacion opcional del circulo en el croquis de la finca: coordenadas normalizadas 0-1
  // (mismo sistema que CroquisPoligono.puntos) mas un radio real en metros.
  croquisId   Int?
  croquis     Croquis? @relation(fields: [croquisId], references: [id], onDelete: SetNull)
  croquisX    Float?
  croquisY    Float?
  radioMetros Float?

  @@index([campanaId])
  @@index([nombre])
  @@index([croquisId])
}

model Plaga {
  id                   Int               @id @default(autoincrement())
  campanaId            Int
  campana              Campana           @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha                DateTime
  nombre               String
  nivelPresencia       NivelInfestacion?
  danosObservados      String?
  tratamientoRealizado String?
  responsable          String?
  notas                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([campanaId])
  @@index([nombre])
}

model Comentario {
  id          Int      @id @default(autoincrement())
  campanaId   Int
  campana     Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha       DateTime
  texto       String
  categoria   String?
  responsable String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campanaId])
}

// ---------------------------------------------------------------------------
// Cosecha / rendimiento
// ---------------------------------------------------------------------------

model Cosecha {
  id                    Int      @id @default(autoincrement())
  campanaId             Int
  campana               Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha                 DateTime
  superficieCosechada   Float?
  produccionTotal       Float?
  rendimientoPorHa      Float?
  calidad               String?
  descarte              Float?
  produccionComercial   Float?
  produccionNoComercial Float?
  notas                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([campanaId])
}

// ---------------------------------------------------------------------------
// Economia
// ---------------------------------------------------------------------------

enum CategoriaCosto {
  SEMILLA
  FERTILIZANTE
  FITOSANITARIO
  MANO_OBRA
  MAQUINARIA
  RIEGO
  COMBUSTIBLE
  COSECHA
  FLETE
  OTRO
}

model Costo {
  id          Int               @id @default(autoincrement())
  campanaId   Int
  campana     Campana           @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  categoria   CategoriaCosto
  descripcion String?
  monto       Float
  fecha       DateTime?
  notas       String?
  // Cuando insumoId/origen/origenId estan seteados, este Costo fue generado automaticamente a
  // partir del consumo de un Insumo valorizado (labor/aplicacion/fertilizacion) y no debe
  // editarse ni borrarse a mano — ver crearCostoAutomatico/eliminarCostoAutomatico en
  // server/src/lib/costoAutomatico.ts. Con estos tres campos en null es un costo manual normal.
  insumoId    Int?
  insumo      Insumo?           @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  origen      OrigenMovimiento?
  origenId    Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([campanaId])
  @@index([origen, origenId])
}

// ---------------------------------------------------------------------------
// Costos indirectos y presupuesto
// ---------------------------------------------------------------------------

enum MetodoDistribucionCosto {
  POR_SUPERFICIE
  POR_PORCENTAJE_COSTOS_DIRECTOS
  POR_PRODUCCION
  POR_VALOR_PRODUCCION
  MANUAL
}

model CostoIndirecto {
  id                 Int                     @id @default(autoincrement())
  fincaId            Int?
  finca              Finca?                  @relation(fields: [fincaId], references: [id], onDelete: SetNull)
  categoria          String
  descripcion        String?
  monto              Float
  fecha              DateTime
  metodoDistribucion MetodoDistribucionCosto
  notas              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  asignaciones CostoIndirectoAsignacion[]

  @@index([fincaId])
  @@index([fecha])
}

model CostoIndirectoAsignacion {
  id               Int            @id @default(autoincrement())
  costoIndirectoId Int
  costoIndirecto   CostoIndirecto @relation(fields: [costoIndirectoId], references: [id], onDelete: Cascade)
  campanaId        Int
  campana          Campana        @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  monto            Float

  @@unique([costoIndirectoId, campanaId])
}

model Presupuesto {
  id                 Int             @id @default(autoincrement())
  campanaId          Int
  campana            Campana         @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  // null = linea "Total campana" (compara contra costos directos + indirectos asignados)
  categoria          CategoriaCosto?
  montoPresupuestado Float
  notas              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([campanaId, categoria])
}

model Venta {
  id             Int      @id @default(autoincrement())
  campanaId      Int
  campana        Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  fecha          DateTime
  cantidadKg     Float
  precioUnitario Float
  ingresoTotal   Float
  comprador      String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([campanaId])
}

// ---------------------------------------------------------------------------
// Imagenes (adjuntos polimorficos)
// ---------------------------------------------------------------------------

enum TipoEntidadImagen {
  CAMPANA
  LABOR
  APLICACION
  FERTILIZACION
  RIEGO
  MALEZA
  ENFERMEDAD
  PLAGA
  EVENTO_CLIMATICO
  COSECHA
  CROQUIS
  CUADRO
  PRODUCTO_COMERCIAL
}

model Imagen {
  id          Int               @id @default(autoincrement())
  path        String
  entityType  TipoEntidadImagen
  entityId    Int
  descripcion String?
  fecha       DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Croquis (plano editable de la finca)
// ---------------------------------------------------------------------------

model Croquis {
  id          Int      @id @default(autoincrement())
  fincaId     Int
  finca       Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  imagenPath  String?
  imagenAncho Int?
  imagenAlto  Int?
  nombre      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Calibracion de escala real: puntoA/puntoB son coordenadas normalizadas 0-1 (igual que
  // CroquisPoligono.puntos) sobre una cota conocida de la imagen; escalaDistanciaM es la
  // distancia real en metros que el usuario indico entre esos dos puntos.
  escalaMetrosPorPixel Float?
  escalaPuntoA         Json?
  escalaPuntoB         Json?
  escalaDistanciaM     Float?

  poligonos            CroquisPoligono[]
  enfermedadesMarcadas Enfermedad[]
  malezasMarcadas      Maleza[]

  @@index([fincaId])
}

model CroquisPoligono {
  id        Int      @id @default(autoincrement())
  croquisId Int
  croquis   Croquis  @relation(fields: [croquisId], references: [id], onDelete: Cascade)
  cuadroId  Int?
  cuadro    Cuadro?  @relation(fields: [cuadroId], references: [id], onDelete: SetNull)
  color     String   @default("#4a7c2c")
  puntos    Json
  etiqueta  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([croquisId])
  @@index([cuadroId])
}

// ---------------------------------------------------------------------------
// Stock de insumos
// ---------------------------------------------------------------------------

enum CategoriaInsumo {
  FITOSANITARIO
  FERTILIZANTE
  SEMILLA
  COMBUSTIBLE
  OTRO
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
}

enum OrigenMovimiento {
  MANUAL
  APLICACION
  FERTILIZACION
  LABOR
  COMPRA
}

model Insumo {
  id            Int             @id @default(autoincrement())
  // null = insumo compartido/sin asignar a una finca en particular (comportamiento previo).
  fincaId       Int?
  finca         Finca?          @relation(fields: [fincaId], references: [id], onDelete: SetNull)
  nombre        String
  categoria     CategoriaInsumo
  unidad        String
  stockActual   Float           @default(0)
  stockMinimo   Float?
  // Costo promedio ponderado vigente, recalculado desde el historial de Compra cada vez que se
  // crea/edita/borra una — ver recalcularCostoUnitario en server/src/lib/costoUnitario.ts.
  costoUnitario Float?
  notas         String?
  activo        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  movimientos     MovimientoStock[]
  compras         Compra[]
  costos          Costo[]
  aplicaciones    AplicacionFitosanitaria[]
  fertilizaciones Fertilizacion[]
  labores         LaborCultural[]

  @@index([categoria])
  @@index([fincaId])
}

model Compra {
  id             Int       @id @default(autoincrement())
  insumoId       Int
  insumo         Insumo    @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  fecha          DateTime
  cantidad       Float
  precioUnitario Float
  montoTotal     Float
  proveedor      String?
  factura        String?
  lote           String?
  vencimiento    DateTime?
  notas          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([insumoId])
  @@index([fecha])
}

model MovimientoStock {
  id        Int                 @id @default(autoincrement())
  insumoId  Int
  insumo    Insumo              @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  tipo      TipoMovimientoStock
  cantidad  Float
  fecha     DateTime
  origen    OrigenMovimiento    @default(MANUAL)
  origenId  Int?
  motivo    String?
  notas     String?
  createdAt DateTime            @default(now())

  @@index([insumoId])
  @@index([origen, origenId])
}

// ---------------------------------------------------------------------------
// Biblioteca de Productos y Principios Activos: catalogo de referencia tecnica
// (que existe, que controla que), independiente de la bitacora real de campo
// (Plaga/Enfermedad/Maleza arriba, que registra lo que efectivamente paso en
// una campana). Se enlazan de forma opcional via AplicacionFitosanitaria.
// ---------------------------------------------------------------------------

enum TipoOrganismo {
  PLAGA
  ACARO
  ENFERMEDAD
  BACTERIA
  MALEZA
  NEMATODO
}

enum Movilidad {
  CONTACTO
  SISTEMICO
  TRANSLAMINAR
  ASCENDENTE
  DESCENDENTE
  OTRO
}

/// Estado de verificacion del uso/registro en Argentina: separa la info tecnica general
/// (bibliografia, uso internacional) de lo efectivamente autorizado localmente, para no
/// asumir que un principio activo esta habilitado para un cultivo/plaga solo porque funciona
/// tecnicamente contra ella.
enum RegistroArgentina {
  VERIFICADO
  NO_VERIFICADO
  NO_REGISTRADO
  INTERNACIONAL
  PENDIENTE
}

/// Eficacia observada en el campo por el usuario para un producto contra un organismo puntual
/// -- distinto de "lo controla segun la ficha": esto es experiencia propia, editable, no un dato
/// de fabricante. SIN_EXPERIENCIA es el default (todavia no lo probo / solo referencia tecnica).
enum EficaciaProducto {
  EFECTIVO
  EFECTIVO_PARCIAL
  NO_EFECTIVO
  SIN_EXPERIENCIA
}

/// Catalogo unificado de organismos objetivo (plagas, acaros, enfermedades, bacterias, malezas,
/// nematodos) que un principio activo o producto puede controlar. Es una tabla de referencia,
/// separada de Plaga/Enfermedad/Maleza (que son bitacora real por campana).
model Organismo {
  id               Int           @id @default(autoincrement())
  tipo             TipoOrganismo
  nombre           String
  nombreCientifico String?
  notas            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  principiosActivos PrincipioActivo[]
  productos         ProductoOrganismo[]

  @@unique([tipo, nombre])
  @@index([tipo])
}

model PrincipioActivo {
  id                    Int               @id @default(autoincrement())
  nombre                String            @unique
  tipo                  TipoFitosanitario
  grupoAccion           String?
  movilidad             Movilidad?
  observaciones         String?
  riesgoResistencia     String?
  recomendacionRotacion String?
  registroArgentina     RegistroArgentina @default(PENDIENTE)
  fuenteInformacion     String?
  fechaVerificacion     DateTime?
  favorito              Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  cultivos            Cultivo[]
  organismos          Organismo[]
  productos           ProductoPrincipioActivo[]
  /// Incompatibilidades documentadas con este principio activo como "lado A" o "lado B" del par
  /// (ver Incompatibilidad — el orden A/B es solo una convención interna para no duplicar el par,
  /// no implica direccionalidad; las consultas siempre miran ambos lados).
  incompatibilidadesA Incompatibilidad[]        @relation("IncompatibilidadA")
  incompatibilidadesB Incompatibilidad[]        @relation("IncompatibilidadB")

  @@index([tipo])
  @@index([grupoAccion])
}

/// Incompatibilidad documentada entre dos principios activos (mezcla, fitotoxicidad, etc.). Es un
/// dato de fuente, no una regla inventada por el sistema: la ausencia de una fila acá NO significa
/// que dos principios sean compatibles, solo que no hay incompatibilidad documentada todavía.
model Incompatibilidad {
  id                 Int             @id @default(autoincrement())
  principioActivoAId Int
  principioActivoA   PrincipioActivo @relation("IncompatibilidadA", fields: [principioActivoAId], references: [id], onDelete: Cascade)
  principioActivoBId Int
  principioActivoB   PrincipioActivo @relation("IncompatibilidadB", fields: [principioActivoBId], references: [id], onDelete: Cascade)
  tipo               String?
  fuente             String?
  observacion        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([principioActivoAId, principioActivoBId])
  @@index([principioActivoBId])
}

model ProductoComercial {
  id                       Int                 @id @default(autoincrement())
  nombreComercial          String
  /// Un producto comercial puede tener más de una categoría (ej. insecticida + acaricida); antes
  /// era un solo TipoFitosanitario, ver migración producto_tipos_array.
  tipos                    TipoFitosanitario[]
  formulacion              String?
  movilidad                Movilidad?
  observaciones            String?
  disponible               Boolean             @default(true)
  proveedor                String?
  precio                   Float?
  presentacion             String?
  fechaActualizacionPrecio DateTime?
  notasPersonales          String?
  registroArgentina        RegistroArgentina   @default(PENDIENTE)
  fuenteInformacion        String?
  fechaVerificacion        DateTime?
  favorito                 Boolean             @default(false)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  cultivos          Cultivo[]
  organismos        ProductoOrganismo[]
  principiosActivos ProductoPrincipioActivo[]
  aplicaciones      AplicacionFitosanitaria[]

  @@index([tipos], type: Gin)
}

model ProductoPrincipioActivo {
  id                  Int               @id @default(autoincrement())
  productoComercialId Int
  productoComercial   ProductoComercial @relation(fields: [productoComercialId], references: [id], onDelete: Cascade)
  principioActivoId   Int
  principioActivo     PrincipioActivo   @relation(fields: [principioActivoId], references: [id], onDelete: Cascade)
  concentracion       Float?
  unidadConcentracion String?

  @@unique([productoComercialId, principioActivoId])
  @@index([principioActivoId])
}

/// Reemplaza lo que en un catalogo simple seria un m2m Producto<->Organismo: cada fila la puede
/// editar el usuario con SU dosis recomendada y SU experiencia de campo (eficacia/notas), no solo
/// "lo controla o no" segun la ficha tecnica.
model ProductoOrganismo {
  id                  Int               @id @default(autoincrement())
  productoComercialId Int
  productoComercial   ProductoComercial @relation(fields: [productoComercialId], references: [id], onDelete: Cascade)
  organismoId         Int
  organismo           Organismo         @relation(fields: [organismoId], references: [id], onDelete: Cascade)
  eficacia            EficaciaProducto  @default(SIN_EXPERIENCIA)
  dosisRecomendada    Float?
  dosisMax            Float?
  unidadDosis         String?
  baseDosis           BaseDosis?
  notas               String?

  @@unique([productoComercialId, organismoId])
  @@index([organismoId])
}
