# Copiá este archivo a ".env" y completá los valores reales (ese .env NO se sube a git).

# Base de datos Postgres de Supabase (Project Settings → Database → Connection string → "Transaction pooler")
DATABASE_URL="postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"

# Supabase → Project Settings → API
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"
